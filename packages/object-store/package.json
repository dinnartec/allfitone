{
  "name": "@allfitone/object-store",
  "version": "0.0.0",
  "private": true,
  "description": "Puerto y adaptador del almacén de objetos privados",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1145.0",
    "@aws-sdk/s3-request-presigner": "3.1145.0"
  }
}
