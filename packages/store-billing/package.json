{
  "name": "@allfitone/store-billing",
  "version": "0.0.0",
  "private": true,
  "description": "Port and adapters that verify App Store and Google Play subscriptions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "google-auth-library": "11.3.0"
  }
}
