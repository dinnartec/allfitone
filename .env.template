# Copy to .env.local and fill in. Never commit real values.
#
#   cp .env.template .env.local
#
# Bun and Next both load .env.local automatically. Vercel reads its own
# environment variables per environment — this file doubles as the checklist for
# what to set there.

# --- Identity provider ------------------------------------------------------
# WorkOS dashboard, API keys section. Server-side only: this never reaches a
# client bundle, and the boundary rules keep the SDK out of the frontends.
WORKOS_API_KEY=

# One client_id per Application. One environment, three Applications, one shared
# user directory: the same person signs into Space and Studio with the same
# credential, but a token issued for one surface is rejected by the others.
WORKOS_CLIENT_ID_SPACE=
WORKOS_CLIENT_ID_STUDIO=
WORKOS_CLIENT_ID_BACKOFFICE=

# Expected `iss` on access tokens. Leave EMPTY until confirmed against a real
# token: a wrong value rejects every login, and whoever debugs that is likely to
# delete the check rather than fix it. Once verified, set it — it is a real
# defence, not decoration.
WORKOS_ISSUER=

# --- Redirect URIs ----------------------------------------------------------
# Register these in the WorkOS dashboard, matching exactly: scheme, host, port,
# path, no trailing slash.
#
# The callback belongs to the API, not to the frontends. A frontend receiving the
# code would have to talk to the provider itself, which the boundary rules forbid
# and which would put credentials in two places.
#
#   Studio      http://localhost:8080/studio/v1/auth/callback
#   Backoffice  http://localhost:8080/backoffice/v1/auth/callback
#   Space       allfitspace://callback   (deep link, headless login)
#
# Where the API sends the person once the session exists.
STUDIO_WEB_URL=http://localhost:3000
BACKOFFICE_WEB_URL=http://localhost:3001

# --- Database ---------------------------------------------------------------
# Pooler in transaction mode. Actor context is set with set_config(..., true),
# which is transaction-local and therefore survives the pooler. Session-scoped
# config would not.
DATABASE_URL=

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=8080

# Base URL the frontends use to reach the API. Public by nature, hence the
# NEXT_PUBLIC_ prefix that lets Next expose it to the browser.
NEXT_PUBLIC_API_URL=http://localhost:8080
