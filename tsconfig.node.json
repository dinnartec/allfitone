{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Bun globals and `bun:test` belong to the server-side workspaces only.
    // Putting them in the base config would force them on the frontends, where
    // Bun does not exist and DOM does.
    "types": ["bun"]
  }
}
