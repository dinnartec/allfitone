# Copy to .env.local and fill in. Never commit real values.
#
# Turbo runs each task from its own workspace, so the dev scripts pass
# --env-file=../../.env.local to reach this one.

# --- Identity provider -------------------------------------------------------
# Each Application has its own client_id AND its own API key.
# Dashboard → Applications → the app → its credentials.
WORKOS_CLIENT_ID_SPACE=
WORKOS_API_KEY_SPACE=

WORKOS_CLIENT_ID_STUDIO=
WORKOS_API_KEY_STUDIO=

WORKOS_CLIENT_ID_BACKOFFICE=
WORKOS_API_KEY_BACKOFFICE=

# One per environment, shared by the three Applications. Required: empty would
# silently disable issuer verification.
# Shape: https://api.workos.com/user_management/<default app client_id>
WORKOS_ISSUER=

# Signing secret for the environment-level POST /webhooks/workos endpoint.
# Dashboard -> Webhooks -> endpoint -> Signing secret.
WORKOS_WEBHOOK_SECRET=

# --- Redirect URIs -----------------------------------------------------------
# Register per Application, matching exactly. The callback belongs to the API:
#   Studio      {API_PUBLIC_URL}/studio/v1/auth/callback
#   Space       allfitspace://callback
# Backoffice has no callback in V1: password + TOTP use server APIs directly.
# BACKOFFICE_WEB_URL is the only allowed CORS Origin. Its auth gate closes only
# new password attempts; session, logout, reset and cleanup remain operational.
API_PUBLIC_URL=http://localhost:8080
STUDIO_WEB_URL=http://localhost:3000
BACKOFFICE_WEB_URL=http://localhost:3001
BACKOFFICE_AUTH_ENABLED=false

# Public because Next.js embeds it in the browser bundle. It must contain only
# the API origin; never put credentials or provider keys in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Space embeds this in the app bundle, so it carries the same rule as
# NEXT_PUBLIC_*: origin only, never a credential. Leave it empty for local work
# — the app derives the host from Metro, which is what makes one build run on
# both the simulator and a phone. A release build has no Metro and refuses to
# start without it, rather than falling back to localhost and reaching users as
# "no internet". Supplied per EAS build profile via eas.json `environment`.
EXPO_PUBLIC_API_URL=

# --- Privacy-preserving telemetry -------------------------------------------
# All gates stay false until the PostHog US production smoke test passes.
# POSTHOG_HOST is deliberately restricted to the canonical US ingestion origin.
# Non-production capture stays disabled while there is no separate project.
# Project tokens are public, but versioned HMAC keys are server secrets.
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_SERVER_API_KEY=
ANALYTICS_SERVER_ENABLED=false
ANALYTICS_PSEUDONYM_ACTIVE_VERSION=1
ANALYTICS_PSEUDONYM_KEY_V1=
ANALYTICS_STUDIO_CLIENT_ENABLED=false
ANALYTICS_BACKOFFICE_CLIENT_ENABLED=false
ANALYTICS_SPACE_CLIENT_ENABLED=false

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_ANALYTICS_ENVIRONMENT=development
NEXT_PUBLIC_APP_RELEASE=local

EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_ANALYTICS_ENVIRONMENT=development
EXPO_PUBLIC_APP_RELEASE=local

# Meta's app id for Space's «Historias» (react-native-share, Instagram Stories).
# Public by design: it travels in the app. Empty falls back to the system sheet.
# Expo reads it from apps/space/.env.local.
EXPO_PUBLIC_META_APP_ID=

# --- Database ----------------------------------------------------------------
# Local uses the bootstrap login but immediately assumes the only runtime role.
# Cloud uses the allfit_api credential through Supavisor transaction mode;
# actor context remains transaction-local with set_config(..., true).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?options=-c%20role%3Dallfit_api

# Base64-encoded 32-byte key used to encrypt provider tokens stored in
# identity.access_sessions. Replacing it intentionally signs out every browser.
SESSION_ENCRYPTION_KEY=

# --- Team invitations (HU-STUDIO-014) ----------------------------------------
# Keep all three gates false until the Studio recipient flow (HU-STUDIO-085/086)
# is deployed. Token keys are base64-encoded 32-byte HMAC keys and are versioned
# so an in-flight invitation remains derivable during rotation.
STAFF_INVITATION_ISSUANCE_ENABLED=false
STAFF_INVITATION_DELIVERY_ENABLED=false
NEXT_PUBLIC_STAFF_INVITATIONS_ENABLED=false
INVITATION_TOKEN_ACTIVE_VERSION=1
INVITATION_TOKEN_KEY_V1=
STAFF_INVITATION_PUBLIC_BASE_URL=https://studio.allfit.one/

# --- Client invitations (HU-STUDIO-023) --------------------------------------
# Gates issuance only. Reading an invitation and answering it stay open, because
# somebody already holding a link must be able to finish or decline whatever was
# sent before the gate closed. Token keys are shared with team invitations
# above: the token is derived from the command id, so the two never collide.
CLIENT_INVITATION_ISSUANCE_ENABLED=false

# Worker-only delivery credentials. Vercel supplies CRON_SECRET as the exact
# bearer value used by the once-per-minute cron request.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CRON_SECRET=

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development

# Docker Desktop often holds 8080 on macOS. Changing this means changing
# API_PUBLIC_URL and the registered redirect URI too.
PORT=8080

# --- Catalogue media ---------------------------------------------------------
# Where the movement demonstrations are served from. The database stores only the
# object key, so moving origin is this variable rather than a data migration.
# Required: without it the projection would hand out addresses that resolve to
# nothing, and the API refuses to answer rather than do that.
# Shape: an origin with no trailing slash, e.g. https://media.allfit.co/catalog
CATALOG_MEDIA_BASE_URL=
