# Copy to .env.local. Never commit real values.

# --- Identity provider ------------------------------------------------------
# The API key exists only on the server. Never in a client bundle.
WORKOS_API_KEY=

# One client_id per Application. One environment, three Applications, one shared
# user directory: the same person signs into Space and Studio with the same
# credential, but their token does not work on the other surface.
WORKOS_CLIENT_ID_SPACE=
WORKOS_CLIENT_ID_STUDIO=
WORKOS_CLIENT_ID_BACKOFFICE=

# --- Database ---------------------------------------------------------------
# Pooler in transaction mode. Actor context is set with set_config(..., true),
# which is transaction-local and therefore survives the pooler.
DATABASE_URL=

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=8080
