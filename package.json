{
  "name": "allfitone",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Allfit One platform monorepo: API, worker, clients and shared libraries",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-svg": "15.15.4",
    "react-native-screens": "4.26.2"
  },
  "packageManager": "bun@1.2.16",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "bun run check:ui-boundaries && turbo run lint",
    "typecheck": "turbo run typecheck",
    "check:ui-boundaries": "node scripts/check-ui-boundaries.mjs",
    "check:db-policy": "node scripts/check-db-policy.mjs",
    "check:openapi": "redocly lint packages/contracts/openapi/allfit-v1.openapi.yaml",
    "generate:contracts": "bun run --cwd packages/contracts generate",
    "check:contracts": "bun run --cwd packages/contracts check:generated",
    "db:start": "supabase start --workdir packages/db",
    "db:stop": "supabase stop --workdir packages/db",
    "db:status": "supabase status --workdir packages/db",
    "db:reset": "supabase db reset --local --workdir packages/db",
    "db:lint": "supabase db lint --local --level warning --fail-on error --workdir packages/db",
    "db:test": "supabase test db --local --workdir packages/db",
    "db:test:concurrency": "bun test packages/db/tests/idempotency-concurrency.test.ts",
    "db:types": "bun packages/db/scripts/generate-types.ts",
    "check:db-types": "bun packages/db/scripts/generate-types.ts --check",
    "db:migration:new": "supabase migration new --workdir packages/db",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "2.43.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.4.2",
    "postgres": "3.4.9",
    "supabase": "2.110.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.66.0"
  }
}
