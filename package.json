{
  "name": "allfitone",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Allfit One platform monorepo: API, worker, clients and shared libraries",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.2.16",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check:openapi": "redocly lint packages/contracts/openapi/allfit-v1.openapi.yaml",
    "generate:contracts": "bun run --cwd packages/contracts generate",
    "check:contracts": "bun run --cwd packages/contracts check:generated",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "2.43.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.4.2",
    "supabase": "2.110.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.66.0"
  }
}
