    "@allfitone/react-native": "file:../../../allfitone-design-system/packages/react-native",
    "@allfitone/telemetry": "workspace:*",
    "@allfitone/tokens": "file:../../../allfitone-design-system/packages/tokens",
    "expo": "57.0.11",
    "expo-blur": "57.0.2",
    "expo-constants": "57.0.9",
    "expo-crypto": "^57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-font": "57.0.1",
    "expo-haptics": "57.0.2",
    "expo-linear-gradient": "57.0.1",
    "expo-linking": "57.0.5",
