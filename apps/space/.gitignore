# them means hand-edits get silently overwritten and drift from the config.
ios/
android/
.expo/
expo-env.d.ts
dist/

# Signing material. Never versioned.
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Local API target. Not versioned: it differs per machine.
.env
