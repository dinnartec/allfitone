{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "jsx": "react-jsx",
    "noEmit": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "allowJs": true,
    "types": ["expo/types"],
    "paths": {
      "@/*": ["./src/*"],
      // One React Native for the whole program. The Design System is read from its
      // own repository while it is being written, and that repository has its own
      // copy — so its .d.ts described a different ViewStyle than this app's, and
      // passing a shadow to a Pressable stopped compiling. Goes when the link goes.
      "react-native": ["../../node_modules/react-native"],
      "react-native/*": ["../../node_modules/react-native/*"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules", "src/**/*.test.ts"]
}
