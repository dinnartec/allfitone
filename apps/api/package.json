{
  "name": "@allfitone/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch --env-file=../../.env.local src/server.ts",
    "prebuild": "bun run --cwd ../../packages/auth-provider build",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "bun test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@allfitone/auth-provider": "workspace:*",
    "@allfitone/contracts": "workspace:*",
    "@allfitone/db": "workspace:*",
    "@allfitone/food-recognition": "workspace:*",
    "@allfitone/notifications": "workspace:*",
    "@allfitone/object-store": "workspace:*",
    "@allfitone/store-billing": "workspace:*",
    "@allfitone/queue": "workspace:*",
    "@allfitone/telemetry": "workspace:*",
    "@vercel/functions": "3.9.3",
    "hono": "^4.6.0",
    "postgres": "3.4.9",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@hono/node-server": "^1.13.0"
  }
}
